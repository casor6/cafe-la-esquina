---
import BotonPedir from "./BotonPedir.astro";

interface Props {
  conBotonPedir?: boolean;
}

const { conBotonPedir = true } = Astro.props;
---

<header class="encabezado">
  <div class="contenedor fila">
    <a class="marca" href="/">
      <span class="marca-pequena">Café</span>
      <span class="marca-grande">La Esquina</span>
    </a>
    <nav aria-label="Secciones">
      <ul>
        <li><a href="/#menu">Menú</a></li>
        <li><a href="/#horario">Horario</a></li>
        <li><a href="/#ubicacion">Dónde estamos</a></li>
      </ul>
    </nav>
    <div class="accion">
      {conBotonPedir && <BotonPedir variante="compacto" texto="Pedir" />}
    </div>
  </div>
</header>

<style>
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(243 235 221 / 0.94);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgb(42 28 19 / 0.12);
  }

  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }

  .marca {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    text-decoration: none;
    font-family: var(--serif);
  }

  .marca-pequena {
    font-style: italic;
    font-size: 1rem;
    color: var(--terracota);
  }

  .marca-grande {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  nav {
    display: none;
  }

  nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-weight: 500;
    text-decoration: none;
    font-size: 0.975rem;
    background: linear-gradient(var(--terracota), var(--terracota)) no-repeat 0 100% / 0 2px;
    transition: background-size 0.2s ease;
    padding-bottom: 2px;
  }

  nav a:hover {
    background-size: 100% 2px;
  }

  @media (min-width: 720px) {
    nav {
      display: block;
    }
  }
</style>
