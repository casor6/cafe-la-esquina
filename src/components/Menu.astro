---
import { ShoppingBag } from "@lucide/astro";
import BotonWhatsApp from "./BotonWhatsApp.astro";
import Taza from "./ilustraciones/Taza.astro";
import { obtenerMenuEnBuild, pesos, type CategoriaMenu } from "../lib/api";

const categorias = await obtenerMenuEnBuild();
const [cafe, ...resto] = categorias;
const acompanar: CategoriaMenu = {
  id: 0,
  nombre: resto.map((c) => c.nombre).join(" · "),
  productos: resto.flatMap((c) => c.productos),
};

const conExtra = cafe.productos.filter((p) => p.opciones?.lista.some((o) => o.precioExtraCentavos > 0));
const extras = conExtra[0]?.opciones?.lista.filter((o) => o.precioExtraCentavos > 0) ?? [];
const nota =
  extras.length > 0
    ? `${conExtra[0].opciones!.grupo} de ${extras.map((o) => o.nombre.toLowerCase()).join(" o ")} +${pesos(extras[0].precioExtraCentavos)} en ${conExtra.map((p) => p.nombre.toLowerCase()).join(" y ")}`
    : null;
---

<section id="menu" class="menu" aria-labelledby="menu-titulo">
  <div class="contenedor">
    <header class="cabecera">
      <p class="etiqueta">Lo que hay en la barra</p>
      <h2 id="menu-titulo">El menú cabe en un pizarrón</h2>
      <p class="intro">Pocas cosas, bien hechas. Precios en pesos mexicanos, IVA incluido.</p>
    </header>

    <div class="pizarron">
      <div class="columna principal">
        <h3>{cafe.nombre}</h3>
        <ul>
          {
            cafe.productos.map((p) => (
              <li>
                <div class="linea">
                  <span class="nombre">{p.nombre}</span>
                  <span class="puntos" aria-hidden="true" />
                  <span class="precio">{pesos(p.precioCentavos)}</span>
                </div>
                <span class="detalle">{p.detalle}</span>
              </li>
            ))
          }
        </ul>
        {nota && <p class="nota">{nota}</p>}
      </div>

      <div class="columna secundaria">
        <h3>{acompanar.nombre}</h3>
        <ul>
          {
            acompanar.productos.map((p) => (
              <li>
                <div class="linea">
                  <span class="nombre">{p.nombre}</span>
                  <span class="puntos" aria-hidden="true" />
                  <span class="precio">{pesos(p.precioCentavos)}</span>
                </div>
                <span class="detalle">{p.detalle}</span>
              </li>
            ))
          }
        </ul>
        <div class="pedido">
          <div class="dibujo">
            <Taza />
          </div>
          <p>¿Vas con prisa? Haz tu pedido aquí, elige a qué hora pasas y pagas en caja al recoger.</p>
          <a class="pedir" href="/pedido">
            <ShoppingBag size={20} stroke-width={2} aria-hidden="true" />
            <span>Pedir para recoger</span>
          </a>
          <p class="alterno">¿Prefieres escribirnos? <BotonWhatsApp variante="enlace" texto="Pide por WhatsApp" /></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .menu {
    padding-block: 5rem;
  }

  .cabecera {
    max-width: 38rem;
    margin-bottom: 2.5rem;
  }

  .cabecera .etiqueta {
    color: var(--terracota);
    margin-bottom: 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.015em;
  }

  .intro {
    margin-top: 0.9rem;
    color: var(--tostado-suave);
  }

  .pizarron {
    display: grid;
    background: var(--tostado);
    color: var(--papel);
    border-radius: var(--radio);
    border: 10px solid #4a3324;
    box-shadow: 0 18px 40px -18px rgb(42 28 19 / 0.6);
  }

  .columna {
    padding: 2.25rem 1.5rem;
  }

  .secundaria {
    border-top: 1px dashed rgb(243 235 221 / 0.25);
  }

  h3 {
    font-size: 1.75rem;
    font-style: italic;
    font-weight: 500;
    color: var(--mostaza);
    margin-bottom: 1.25rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .linea {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .nombre {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
  }

  .puntos {
    flex: 1;
    border-bottom: 2px dotted rgb(243 235 221 / 0.35);
    transform: translateY(-0.3rem);
  }

  .precio {
    font-weight: 600;
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }

  .detalle {
    display: block;
    font-size: 0.9375rem;
    color: rgb(243 235 221 / 0.68);
  }

  .nota {
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(243 235 221 / 0.18);
    font-size: 0.9375rem;
    color: var(--mostaza);
  }

  .pedido {
    margin-top: 2.25rem;
    padding: 1.5rem;
    background: var(--botella);
    border-radius: var(--radio);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .dibujo {
    width: 3.5rem;
    color: var(--mostaza);
  }

  .pedir {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.4rem;
    border-radius: var(--radio);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    background: var(--papel);
    color: var(--tostado);
    box-shadow: 0 3px 0 rgb(0 0 0 / 0.35);
    transition: background-color 0.15s ease;
  }

  .pedir:hover {
    background: #fff;
  }

  .alterno {
    font-size: 0.9375rem;
    color: rgb(243 235 221 / 0.75);
  }

  @media (min-width: 720px) {
    .columna {
      padding: 2.75rem 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .pizarron {
      grid-template-columns: 1.25fr 1fr;
    }

    .columna {
      padding: 3rem 3.25rem;
    }

    .secundaria {
      border-top: 0;
      border-left: 1px dashed rgb(243 235 221 / 0.25);
    }
  }
</style>
