---
import BotonPedir from "./BotonPedir.astro";
import Taza from "./ilustraciones/Taza.astro";
import { obtenerCatalogo } from "../lib/catalogo";
import { htmlColumnas } from "../lib/menuHtml";

const columnas = htmlColumnas(await obtenerCatalogo());
---

<section id="menu" class="menu" aria-labelledby="menu-titulo">
  <div class="contenedor">
    <header class="cabecera">
      <p class="etiqueta">Lo que hay en la barra</p>
      <h2 id="menu-titulo">El menú cabe en un pizarrón</h2>
      <p class="intro">Pocas cosas, bien hechas. Precios en pesos mexicanos, IVA incluido.</p>
    </header>

    <div class="pizarron">
      <div class="columna principal" data-menu="principal" set:html={columnas.principal} />

      <div class="columna secundaria">
        <div data-menu="resto" set:html={columnas.resto} />
        <div class="pedido">
          <div class="dibujo">
            <Taza />
          </div>
          <p>¿Vas con prisa? Haz tu pedido aquí, elige a qué hora pasas y pagas en caja al recoger.</p>
          <BotonPedir variante="claro" texto="Hacer mi pedido" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { obtenerCatalogo } from "../lib/catalogo";
  import { htmlColumnas } from "../lib/menuHtml";

  obtenerCatalogo()
    .then((catalogo) => {
      const columnas = htmlColumnas(catalogo);
      const principal = document.querySelector('[data-menu="principal"]');
      const resto = document.querySelector('[data-menu="resto"]');
      if (principal && resto) {
        principal.innerHTML = columnas.principal;
        resto.innerHTML = columnas.resto;
      }
    })
    .catch(() => {});
</script>

<style is:global>
  .menu {
    padding-block: 5rem;
  }

  .menu .cabecera {
    max-width: 38rem;
    margin-bottom: 2.5rem;
  }

  .menu .cabecera .etiqueta {
    color: var(--terracota);
    margin-bottom: 0.75rem;
  }

  .menu h2 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.015em;
  }

  .menu .intro {
    margin-top: 0.9rem;
    color: var(--tostado-suave);
  }

  .menu .pizarron {
    display: grid;
    background: var(--tostado);
    color: var(--papel);
    border-radius: var(--radio);
    border: 10px solid #4a3324;
    box-shadow: 0 18px 40px -18px rgb(42 28 19 / 0.6);
  }

  .menu .columna {
    padding: 2.25rem 1.5rem;
  }

  .menu .secundaria {
    border-top: 1px dashed rgb(243 235 221 / 0.25);
  }

  .menu .bloque + .bloque {
    margin-top: 2.25rem;
  }

  .menu h3 {
    font-size: 1.75rem;
    font-style: italic;
    font-weight: 500;
    color: var(--mostaza);
    margin-bottom: 1.25rem;
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .menu .linea {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .menu .nombre {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
  }

  .menu .puntos {
    flex: 1;
    border-bottom: 2px dotted rgb(243 235 221 / 0.35);
    transform: translateY(-0.3rem);
  }

  .menu .precio {
    font-weight: 600;
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }

  .menu .sello {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mostaza);
    border: 1.5px solid currentColor;
    border-radius: 3px;
    padding: 0.1rem 0.45rem;
    transform: rotate(-3deg);
  }

  .menu .agotado .nombre,
  .menu .agotado .detalle {
    opacity: 0.55;
  }

  .menu .detalle {
    display: block;
    font-size: 0.9375rem;
    color: rgb(243 235 221 / 0.68);
  }

  .menu .extra {
    display: block;
    font-size: 0.875rem;
    color: var(--mostaza);
  }

  .menu .pedido {
    margin-top: 2.25rem;
    padding: 1.5rem;
    background: var(--botella);
    border-radius: var(--radio);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .menu .dibujo {
    width: 3.5rem;
    color: var(--mostaza);
  }

  @media (min-width: 720px) {
    .menu .columna {
      padding: 2.75rem 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .menu .pizarron {
      grid-template-columns: 1.25fr 1fr;
    }

    .menu .columna {
      padding: 3rem 3.25rem;
    }

    .menu .secundaria {
      border-top: 0;
      border-left: 1px dashed rgb(243 235 221 / 0.25);
    }
  }
</style>
