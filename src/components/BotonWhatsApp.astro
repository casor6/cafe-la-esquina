---
import { MessageCircle } from "@lucide/astro";
import { negocio } from "../data/negocio";

interface Props {
  texto?: string;
  variante?: "primario" | "claro" | "compacto" | "flotante" | "enlace";
}

const { texto = "Pedir por WhatsApp", variante = "primario" } = Astro.props;
const esFlotante = variante === "flotante";
const tamanoIcono = esFlotante ? 26 : variante === "enlace" ? 16 : 20;
---

<a
  class:list={["boton", variante]}
  href={negocio.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={esFlotante ? "Pedir por WhatsApp" : undefined}
>
  <MessageCircle size={tamanoIcono} stroke-width={2} aria-hidden="true" />
  {!esFlotante && <span>{texto}</span>}
</a>

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.4rem;
    border-radius: var(--radio);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    line-height: 1;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .boton:active {
    transform: translateY(1px);
  }

  .primario {
    background: var(--terracota);
    color: #fff;
    box-shadow: 0 3px 0 var(--terracota-oscura);
  }

  .primario:hover {
    background: var(--terracota-oscura);
  }

  .claro {
    background: var(--papel);
    color: var(--tostado);
    box-shadow: 0 3px 0 rgb(0 0 0 / 0.35);
  }

  .claro:hover {
    background: #fff;
  }

  .compacto {
    padding: 0.6rem 1rem;
    font-size: 0.9375rem;
    background: var(--tostado);
    color: var(--papel);
  }

  .compacto:hover {
    background: var(--terracota);
  }

  .enlace {
    display: inline-flex;
    gap: 0.35rem;
    padding: 0;
    font-size: inherit;
    color: var(--mostaza);
    text-decoration: underline;
    text-underline-offset: 3px;
    vertical-align: baseline;
  }

  .enlace:hover {
    color: var(--papel);
  }

  .flotante {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 30;
    width: 3.75rem;
    height: 3.75rem;
    padding: 0;
    justify-content: center;
    border-radius: 50%;
    background: var(--terracota);
    color: #fff;
    box-shadow:
      0 3px 0 var(--terracota-oscura),
      0 10px 24px rgb(42 28 19 / 0.3);
  }

  @media (min-width: 720px) {
    .flotante {
      display: none;
    }
  }
</style>
